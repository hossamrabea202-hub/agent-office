   Begin Object Name="MaterialExpressionCustom_3" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/CastleDefender/UI/HUD/M_UI_GoldDigits.M_UI_GoldDigits:MaterialExpressionCustom_3'"
      Code="\n// gold digits + the menu-style shine: a slanted bright band sliding across the screen every ~3.5 s,\n// only on the metal (not the dark outline / shadow)\nfloat lum = dot(C.rgb, float3(0.3, 0.59, 0.11));\nfloat metal = saturate((C.r - C.b) * 3.0) * saturate((lum - 0.15) * 4.0);\nfloat x = SP.x + SP.y * 0.22;\n// AnimPolish20: eased sweep (2 s) then a 3 s rest\nfloat cyc = frac(Tm * 0.2);\nfloat ek = saturate(cyc / 0.4); ek = ek * ek * (3.0 - 2.0 * ek);\nfloat ph = lerp(-0.4, 1.4, ek);\nfloat band = exp(-pow((x - ph) / 0.018, 2.0));\nfloat glint = exp(-pow((x - ph + 0.012) / 0.005, 2.0));\nfloat3 base = lerp(C.rgb, dot(C.rgb, float3(0.3, 0.59, 0.11)).xxx, 0.32);   // a touch desaturated\nfloat3 col = base + float3(1.0, 0.94, 0.78) * (band * 0.9 + glint * 1.4) * metal;\nOp = C.a;\nreturn col;\n"
      Inputs(0)=(InputName="C",Input=(Expression="/Script/Engine.MaterialExpressionTextureSample'M_UI_GoldDigits:MaterialExpressionTextureSample_3'",OutputIndex=5,Mask=1,MaskR=1,MaskG=1,MaskB=1,MaskA=1))
      Inputs(1)=(InputName="SP",Input=(Expression="/Script/Engine.MaterialExpressionScreenPosition'M_UI_GoldDigits:MaterialExpressionScreenPosition_3'"))
      Inputs(2)=(InputName="Tm",Input=(Expression="/Script/Engine.MaterialExpressionTime'M_UI_GoldDigits:MaterialExpressionTime_3'"))
      AdditionalOutputs(0)=(OutputName="Op")
      MaterialExpressionEditorX=-350
      MaterialExpressionEditorY=50
      MaterialExpressionGuid=E1AF477D46B4F29F4134DCA531ACA319
      Material="/Script/Engine.Material'M_UI_GoldDigits'"
      bShowOutputNameOnPin=True
      Outputs(0)=(OutputName="return")
      Outputs(1)=(OutputName="Op")
   End Object
