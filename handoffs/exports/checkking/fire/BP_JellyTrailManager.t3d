      Begin Object Name="JT_112" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CastleDefender/Gameplay/JellyTrail/BP_JellyTrailManager.BP_JellyTrailManager:EventGraph.JT_112'"
         CommentColor=(R=0.550000,G=0.320000,B=0.080000,A=1.000000)
         NodePosX=-2064
         NodePosY=-4752
         NodeWidth=4400
         NodeHeight=2350
         NodeComment="#32 Tick damage every DmgEvery (0.25 s) while anything burns: each Character whose feet are in fire takes BurnDPS x DmgEvery x rate. Zombie: x2 if ZType 5, x1 else, dead skipped, Mesh GlobalAnimRateScale held < 0.9 during ApplyDamage (BP_Zombie skips its stagger/launch then). Soldier: State.X -= dmg while State.Z < 0.5 (their AnyDamage ignores non-zombie causers). Hero: x0.25. Others: ApplyDamage x1."
         NodeGuid=35FB83B640B354C24E1CE3849AB61ADB
      End Object
